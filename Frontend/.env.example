# AIRD Frontend environment variables.
# Copy to `.env` and adjust as needed.

# Base URL of the tRPC backend (ngo-management-system). When unset, the app
# falls back to built-in typed mock data so the site runs standalone.
VITE_API_URL=http://localhost:5000/api/trpc

# Public verification root used when generating membership QR codes.
VITE_VERIFY_URL=https://airdup.com/verify/member

# Razorpay key (client-side). Optional — Donate page works without it.
VITE_RAZORPAY_KEY_ID=
